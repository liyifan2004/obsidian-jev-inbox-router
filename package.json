{
	"name": "obsidian-jev-inbox-router",
	"version": "0.1.0",
	"description": "Obsidian plugin: route incoming notes to the right folder using JEV (TypeSafe System One) typed decisions.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "npm run typecheck && npm run test && npm run build",
		"sync": "node scripts/sync-to-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"jev",
		"typesafe",
		"inbox",
		"routing"
	],
	"author": "liyifan2004",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"vitest": "^5.0.1"
	}
}
