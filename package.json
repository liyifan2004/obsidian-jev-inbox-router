{
	"name": "obsidian-jev-inbox-router",
	"version": "0.1.0",
	"description": "Obsidian plugin: route incoming notes to the right folder using JEV (TypeSafe System One) typed decisions.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"sync": "node scripts/sync-to-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"jev",
		"typesafe",
		"inbox",
		"routing"
	],
	"author": "liyifan2004",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.2",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5"
	}
}
